{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "calver-short",
    "tagTemplate": "v{version}",
    "recoverMissedReleases": true
  },
  "package": [
    {
      "name": "plugin",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [
        { "path": "plugin.json", "format": "json" }
      ]
    }
  ]
}
