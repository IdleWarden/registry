{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",

  "workspace": {
    "versioning": "calver-short",
    "tagTemplate": "v{version}",
    "recoverMissedReleases": true
  },

  "package": [
    {
      "name": "registry",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [{ "path": "Cargo.toml", "format": "toml" }]
    }
  ]
}
